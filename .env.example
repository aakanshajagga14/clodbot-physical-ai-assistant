# Simulation is deliberately the safe default.
CLODBOT_MODE=simulation
CLODBOT_CYBERWAVE_MOCK=true
# `playground` avoids starting a billable MuJoCo cloud instance by default.
CLODBOT_CYBERWAVE_RUNTIME=playground
CLODBOT_ALLOW_LIVE=

# Fill these values, install the Cyberwave extra, then set
# CLODBOT_CYBERWAVE_MOCK=false to connect the real Cyberwave digital twin.
CYBERWAVE_API_KEY=
CYBERWAVE_TWIN_ID=
CYBERWAVE_ENVIRONMENT_ID=
CYBERWAVE_CAMERA_TWIN_ID=
